# Shared split sizes (smaller than scope.pdf 3000/1000; extension scaled similarly).
export CATGEN_TRAIN_N="${CATGEN_TRAIN_N:-1500}"
export CATGEN_REF_N="${CATGEN_REF_N:-500}"
export CATGEN_FID_N="${CATGEN_FID_N:-500}"
# Extension: per-class counts -> mixed_train_{2*N}, mixed_ref_{2*N}
export CATGEN_MIXED_TRAIN_PER_CLASS="${CATGEN_MIXED_TRAIN_PER_CLASS:-400}"
export CATGEN_MIXED_REF_PER_CLASS="${CATGEN_MIXED_REF_PER_CLASS:-200}"
export CATGEN_EXT_FID_N="${CATGEN_EXT_FID_N:-400}"
